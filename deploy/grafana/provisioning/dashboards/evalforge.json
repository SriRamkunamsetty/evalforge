{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Inter-Annotator Agreement (Krippendorff's α)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "evalforge_krippendorff_alpha", "legendFormat": "Alpha" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "green", "value": 0.67 },
              { "color": "dark-green", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "title": "Total Tasks & Consensus Battles",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "evalforge_tasks_total", "legendFormat": "Tasks" },
        { "expr": "evalforge_consensus_tasks_total", "legendFormat": "Consensus" }
      ]
    },
    {
      "title": "Rater Quality Control (Active vs Flagged)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "evalforge_raters_total", "legendFormat": "Active Raters" },
        { "expr": "evalforge_flagged_raters", "legendFormat": "Flagged Raters" }
      ]
    },
    {
      "title": "Total Annotations Ingested",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "evalforge_annotations_total", "legendFormat": "Annotations" }]
    },
    {
      "title": "Annotation Throughput Rate (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "rate(evalforge_annotations_total[5m]) * 60", "legendFormat": "Annotations/min" }]
    },
    {
      "title": "Consensus Formation Velocity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "rate(evalforge_consensus_tasks_total[5m]) * 60", "legendFormat": "Consensus/min" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["evalforge", "llm-evaluation", "mlops"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "EvalForge Production ML & Rater Telemetry",
  "version": 1
}
